{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "iad1"
  ],
  "crons": [
    {
      "path": "/api/cron/sync?tier=hourly&slot=day",
      "schedule": "5 11-23/2 * * *"
    },
    {
      "path": "/api/cron/sync?tier=hourly&slot=night",
      "schedule": "5 3 * * *"
    },
    {
      "path": "/api/cron/sync?tier=daily",
      "schedule": "20 10 * * *"
    },
    {
      "path": "/api/cron/text-alerts?slot=day",
      "schedule": "*/15 11-23 * * *"
    },
    {
      "path": "/api/cron/text-alerts?slot=night",
      "schedule": "0 0,3,6,9 * * *"
    },
    {
      "path": "/api/cron/tenantturner?slot=day",
      "schedule": "*/15 11-23 * * *"
    },
    {
      "path": "/api/cron/tenantturner?slot=night",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/push-alerts",
      "schedule": "*/15 11-23 * * *"
    },
    {
      "path": "/api/cron/daily-summary",
      "schedule": "0 10,11 * * 1-5"
    }
  ]
}
