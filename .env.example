# Copy to .env for local development. See DEPLOY.md for the full walkthrough.

# --- Database ----------------------------------------------------------------
# Local dev uses a file-based SQLite database — zero setup.
DATABASE_URL="file:./dev.db"
# For a hosted deploy, point this at the SQLite file on your mounted volume,
# e.g. DATABASE_URL="file:/data/prod.db" (see DEPLOY.md).

# --- Login gate --------------------------------------------------------------
# The whole app is protected by a username + password (HTTP Basic Auth).
# Set BOTH to require login. Leave BOTH blank to run open (local dev only).
# NEVER deploy publicly with these blank — the app holds real tenant data.
BASIC_AUTH_USER=""
BASIC_AUTH_PASSWORD=""

# --- Sibling apps (linked from the sidebar) ----------------------------------
# Separate apps the sidebar links out to. Each defaults to PMI's deployed URL;
# set these to override for another deployment.
INSPECTIONS_URL=""   # default: https://pmilighthouse.app/inspections.html
INVOICING_URL=""     # default: https://invoicing.pmilighthouse.app/

# --- Search (LeadSimple activity, via Supabase) ------------------------------
# The Search module queries the synced LeadSimple `activities` table in Supabase.
# Set both to enable it (keys stay server-side). The anon key is fine (the table
# is read-only via row-level security).
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# --- Feature flags -----------------------------------------------------------
# Every module is ON by default. Turn one off (to sell the product in pieces)
# by setting its flag to off/false/0/no. Modules: DASHBOARD, PROPERTIES,
# SQUATTER_WATCH, PORTFOLIOS, LEASES, TENANTS, WORK_ORDERS, SEARCH, INSPECTIONS,
# INVOICING. Example:
# FEATURE_INVOICING=off
