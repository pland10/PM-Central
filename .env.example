# Copy to .env for local development. See DEPLOY.md for the full walkthrough.

# --- Database ----------------------------------------------------------------
# Local dev uses a file-based SQLite database — zero setup.
DATABASE_URL="file:./dev.db"
# For a hosted deploy, point this at the SQLite file on your mounted volume,
# e.g. DATABASE_URL="file:/data/prod.db" (see DEPLOY.md).

# --- Login gate --------------------------------------------------------------
# Two modes, chosen by AUTH_MODE:
#   basic     (default) — HTTP Basic Auth, below. Nothing changes until you opt in.
#   supabase            — real per-user login via Supabase Auth (see next block).
AUTH_MODE="basic"

# Basic Auth (AUTH_MODE=basic): set BOTH to require a shared username + password.
# Leave BOTH blank to run open (local dev only). NEVER deploy publicly blank.
BASIC_AUTH_USER=""
BASIC_AUTH_PASSWORD=""

# Supabase Auth (AUTH_MODE=supabase): real per-user login + roles, shared across
# the whole app (the "SSO"). Point these at the identity-hub Supabase project
# (the one that holds the user accounts — for PMI that's the project that also
# holds inspections). These are PUBLIC (browser) values — use the ANON /
# publishable key here, NEVER the service_role/secret key.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# --- Sibling apps (linked from the sidebar) ----------------------------------
# Separate apps the sidebar links out to (still embedded via iframe). Defaults
# to PMI's deployed URL; set to override for another deployment.
INSPECTIONS_URL=""   # default: https://pmilighthouse.app/inspections.html

# --- Search (LeadSimple activity, via Supabase) ------------------------------
# The Search module queries the synced LeadSimple `activities` table in Supabase.
# Set both to enable it (keys stay server-side). The anon key is fine here (that
# table is anon-readable by design).
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# --- Invoicing (native, read-only, via its own Supabase project) -------------
# Invoicing is a native read-only view over the live invoicing database. It is a
# SEPARATE Supabase project from Search. The invoices table is locked to
# signed-in users, so PM-Central reads it server-side with the project's
# service_role key. Set BOTH to enable it.
#   ⚠ The service_role key is a powerful secret — server-side ONLY. Never put it
#     in a NEXT_PUBLIC_* var or commit it. PM-Central only ever reads (SELECT);
#     the standalone invoicing app stays the only writer.
INVOICING_SUPABASE_URL=""
INVOICING_SUPABASE_SERVICE_KEY=""

# --- Feature flags -----------------------------------------------------------
# Every module is ON by default. Turn one off (to sell the product in pieces)
# by setting its flag to off/false/0/no. Modules: DASHBOARD, PROPERTIES,
# SQUATTER_WATCH, PORTFOLIOS, LEASES, TENANTS, WORK_ORDERS, SEARCH, INSPECTIONS,
# INVOICING. Example:
# FEATURE_INVOICING=off
