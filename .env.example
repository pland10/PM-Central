# Copy to .env for local development. See DEPLOY.md for the full walkthrough.

# --- Database (Postgres) -----------------------------------------------------
# Local Postgres from docker-compose (run: docker compose up -d db):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pmcentral?schema=public"
# Or a free hosted Postgres (e.g. Neon) — paste its connection string instead:
# DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# --- Login gate --------------------------------------------------------------
# The whole app is protected by a username + password (HTTP Basic Auth).
# Set BOTH to require login. Leave BOTH blank to run open (local dev only).
# NEVER deploy publicly with these blank — the app holds real tenant data.
BASIC_AUTH_USER=""
BASIC_AUTH_PASSWORD=""
