# Copy to .env for local development. See DEPLOY.md for the full walkthrough.

# --- Database ----------------------------------------------------------------
# Local dev uses a file-based SQLite database — zero setup.
DATABASE_URL="file:./dev.db"
# For a hosted deploy, point this at the SQLite file on your mounted volume,
# e.g. DATABASE_URL="file:/data/prod.db" (see DEPLOY.md).

# --- Login gate --------------------------------------------------------------
# The whole app is protected by a username + password (HTTP Basic Auth).
# Set BOTH to require login. Leave BOTH blank to run open (local dev only).
# NEVER deploy publicly with these blank — the app holds real tenant data.
BASIC_AUTH_USER=""
BASIC_AUTH_PASSWORD=""

# --- Inspections app ---------------------------------------------------------
# The inspection site is a separate app; the sidebar "Inspections" tab opens it.
# Defaults to https://pmilighthouse.app/inspections.html — set this to override
# for another deployment.
INSPECTIONS_URL=""
