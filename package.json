{
  "name": "pm-central",
  "version": "0.1.0",
  "private": true,
  "description": "PM-Central — a property management hub. Foundation: a list of properties, backed by a database, designed to pull from multiple sources.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "import": "tsx scripts/import.ts",
    "sync:balances": "tsx scripts/sync-balances.ts",
    "sync:rentvine": "tsx scripts/sync-rentvine.ts",
    "sync:rentvine:wos": "tsx scripts/sync-rentvine-work-orders.ts",
    "migrate:invoices": "tsx scripts/migrate-invoices-to-neon.ts",
    "migrate:inspections": "tsx scripts/migrate-inspections-to-neon.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^6.1.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.45.0",
    "jszip": "^3.10.2",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "write-excel-file": "^2.3.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.26",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.49",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
